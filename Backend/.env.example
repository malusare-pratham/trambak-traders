PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mandi_app
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Optional: seed one admin only if no admin with this email exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Optional: required only for forgot-password email delivery.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
